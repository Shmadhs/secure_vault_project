# Never commit vaults, keyfiles or plaintext exports
*.svault
vault.db
*.key
*.keyfile
export*.csv
export*.json
backups/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Build output (binaries are built in CI, never committed)
dist/
build/
*.spec

# Tool caches and reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
